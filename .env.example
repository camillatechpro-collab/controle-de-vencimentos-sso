# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# URL do banco (SQLAlchemy). Padrão: SQLite em data/sst.db
SST_DATABASE_URL=sqlite:///data/sst.db

# Pasta dos anexos (fora de qualquer pasta servida publicamente)
SST_ANEXOS_DIR=data/anexos

# Pasta de logs
SST_LOG_DIR=logs
SST_LOG_LEVEL=INFO

# Fuso usado para calcular "hoje" (status dos vencimentos)
SST_TIMEZONE=America/Sao_Paulo

# Segurança de sessão / login
SST_SESSAO_TIMEOUT_MIN=30
SST_LOGIN_MAX_TENTATIVAS=5
SST_LOGIN_BLOQUEIO_MIN=15

# Anexos
SST_ANEXO_MAX_MB=10

# Consulta de CNPJ (dados públicos). {cnpj} é substituído pelo número.
SST_CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1/{cnpj}
SST_CNPJ_API_TIMEOUT=8

# Consulta de CPF: somente com fornecedor AUTORIZADO e contratado (LGPD).
# Vazio = apenas validação dos dígitos e preenchimento manual.
SST_CPF_PROVEDOR=
